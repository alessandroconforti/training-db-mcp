# training-db MCP server — environment variables (example).
#
# All credentials arrive ONLY from the environment at runtime. No secret is ever
# hardcoded in the source. The host process injects these per session at spawn
# time; never commit real values.

# The auth.users.id (uuid) this MCP instance is bound to. Injected per-session by
# the host process. The server fails fast at startup if missing or not a uuid.
MCP_USER_ID=00000000-0000-0000-0000-000000000000

# Postgres connection string for the Supabase pooler (generic template — never a
# real host). The server fails fast if missing.
SUPABASE_DB_URL=postgres://USER:PASSWORD@HOST:PORT/DBNAME

# TLS toggle for the pooler connection. Default on. Set to 0/false/off/no to
# disable (e.g. local plain Postgres).
SUPABASE_DB_SSL=1

# API key for USDA FoodData Central, required by the nutrition lookup pipeline.
NUTRITION_USDA_API_KEY=your-usda-api-key

# Optional: directory for the on-disk nutrition lookup cache.
# NUTRITION_CACHE_DIR=./.nutrition-cache

# Optional: bearer token + base URL for an internal projection endpoint. If
# either is absent, roadmap projections resolve to null (the bundle never breaks).
# ROADMAP_PROJECTION_SECRET=your-projection-secret
# ROADMAP_PROJECTION_BASE_URL=https://your-host.example.com
